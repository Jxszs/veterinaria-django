# Variables de entorno para el proyecto veterinaria
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# -------------------------------------------------------------------
# Django
# -------------------------------------------------------------------
# Clave secreta de Django — genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambiar-por-una-clave-alta-secreta

# Modo depuración: True para desarrollo, False para producción
DEBUG=True

# Hosts permitidos separados por coma (ej: 127.0.0.1,localhost,tu-dominio.com)
ALLOWED_HOSTS=127.0.0.1,localhost

# -------------------------------------------------------------------
# Base de datos — Supabase (PostgreSQL online)
# -------------------------------------------------------------------
# URL de conexión a la base de datos de Supabase.
# En Supabase: Project Settings → Database → Connection string → URI
# Ejemplo:
# DATABASE_URL=postgresql://postgres.xxx:your_password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Si DATABASE_URL está vacío, se usa SQLite local para desarrollo:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
DB_ENGINE=
DB_NAME=

# -------------------------------------------------------------------
# Email (para alertas automáticas de vacunas y citas)
# -------------------------------------------------------------------
# Servidor SMTP (ej: smtp.gmail.com para Gmail)
EMAIL_HOST=smtp.gmail.com
# Puerto SMTP (587 para TLS, 465 para SSL)
EMAIL_PORT=587
# Cuenta de email de envío
EMAIL_HOST_USER=tu-email@gmail.com
# Contraseña de aplicación (no la contraseña de la cuenta)
EMAIL_HOST_PASSWORD=
# ¿Usar TLS?
EMAIL_USE_TLS=True
# Email por defecto desde el que se envían las alertas
DEFAULT_FROM_EMAIL=tu-email@gmail.com

# -------------------------------------------------------------------
# Opcional: Supabase Storage para fotos de mascotas
# -------------------------------------------------------------------
# URL de la bucket de Supabase Storage (si se usa)
# SUPABASE_STORAGE_URL=https://xxx.supabase.co/storage/v1/object/public/mascotas
SUPABASE_STORAGE_URL=
